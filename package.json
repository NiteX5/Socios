{
  "name": "socioindice",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "SocioIndice: indice digital de socios (Next.js + Firebase)",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:rules": "firebase emulators:exec --only firestore --project demo-socios-rules \"vitest run --config tests/rules/vitest.config.ts\"",
    "test:integration": "firebase emulators:exec --only auth,firestore --project demo-socios \"vitest run --config tests/integration/vitest.config.ts\"",
    "test:e2e": "firebase emulators:exec --only auth,firestore --project demo-socios \"playwright test\""
  },
  "dependencies": {
    "firebase": "13.1.0",
    "lucide-react": "1.61.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.3",
    "firebase-admin": "14.5.0",
    "firebase-tools": "15.34.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.6"
  }
}
